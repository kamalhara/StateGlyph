{
  "name": "stateglyph",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Typed, accessible state icons for React.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "predev": "npm run build:packages",
    "dev": "npm run dev --workspace=@stateglyph/docs",
    "build": "npm run build:packages && npm run build --workspace=@stateglyph/docs",
    "build:packages": "npm run build --workspace=@stateglyph/core && npm run build --workspace=@stateglyph/react && npm run build --workspace=@stateglyph/cli && npm run build --workspace=@stateglyph/transitions",
    "typecheck": "npm run build:packages && npm run typecheck:workspaces",
    "typecheck:workspaces": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "npm run build:packages && changeset publish"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "packageManager": "npm@10.9.3",
  "license": "MIT",
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22.19.0",
    "@vitest/coverage-v8": "^5.0.1",
    "jsdom": "^29.1.1",
    "picomatch": "^4.0.7",
    "prettier": "^3.9.9",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
