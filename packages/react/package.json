{
  "name": "@stateicons/react",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean --external react --external react-dom",
    "dev": "tsup src/index.ts --format esm --dts --watch --external react --external react-dom",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@stateicons/core": "0.0.0",
    "@stateicons/transitions": "0.0.0",
    "lucide-react": "^1.47.0"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  }
}
