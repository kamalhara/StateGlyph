{
  "name": "@stateglyph/react",
  "version": "0.1.0",
  "description": "Typed, accessible state icon components for React.",
  "license": "MIT",
  "author": "Kamalveer Singh",
  "keywords": [
    "react",
    "icons",
    "typescript",
    "state",
    "lucide",
    "accessibility"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kamalhara/StateGlyph.git",
    "directory": "packages/react"
  },
  "homepage": "https://github.com/kamalhara/StateGlyph#readme",
  "bugs": {
    "url": "https://github.com/kamalhara/StateGlyph/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/icons/*-state-icon.d.ts",
      "import": "./dist/icons/*-state-icon.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup --config tsup.config.ts",
    "dev": "tsup --config tsup.config.ts --watch",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@stateglyph/core": "^0.1.0",
    "lucide-react": "^1.47.0"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  }
}
