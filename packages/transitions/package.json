{
  "name": "@stateglyph/transitions",
  "version": "0.1.0",
  "description": "CSS transitions for StateGlyph React icons.",
  "license": "MIT",
  "author": "Kamalveer Singh",
  "keywords": [
    "icons",
    "css",
    "transitions",
    "animation",
    "accessibility"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kamalhara/StateGlyph.git",
    "directory": "packages/transitions"
  },
  "homepage": "https://github.com/kamalhara/StateGlyph#readme",
  "bugs": {
    "url": "https://github.com/kamalhara/StateGlyph/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": [
    "./dist/styles.css"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean && cp src/styles.css dist/styles.css",
    "dev": "tsup src/index.ts --format esm --dts --watch",
    "prepack": "node ../../scripts/sync-package-legal-files.mjs",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
